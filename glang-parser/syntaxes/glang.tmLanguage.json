{
    "scopeName": "source.glang",
    "name": "G",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#function-definitions"
        },
        {
            "include": "#function-calls"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.g",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.g",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "function-definitions": {
            "patterns": [
                {
                    "name": "entity.name.function.g",
                    "match": "(?<=:)\\s*[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },

        "function-calls": {
            "patterns": [
                {
                    "name": "entity.name.function.g",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.g",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.g",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.g",
                    "match": "\\+|-|\\*|/"
                },
                {
                    "name": "keyword.operator.bitwise.g",
                    "match": "&|\\^|!"
                },
                {
                    "name": "keyword.operator.declaration.g",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.comma.g",
                    "match": ","
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.g",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },

        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.g",
                    "match": ";"
                },
                {
                    "name": "punctuation.parenthesis.begin.g",
                    "match": "\\("
                },
                {
                    "name": "punctuation.parenthesis.end.g",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.block.begin.g",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.block.end.g",
                    "match": "\\}"
                }
            ]
        },

        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.g",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        }
    }
}